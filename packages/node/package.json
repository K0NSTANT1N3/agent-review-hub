{
  "name": "@quorum/node",
  "version": "0.1.0",
  "description": "Quorum agent Node: runs one person's coding agent for Quorum, headless or on a server (quorum-node)",
  "license": "MIT",
  "keywords": [
    "quorum",
    "code-review",
    "coding-agents",
    "claude-code"
  ],
  "homepage": "https://github.com/K0NSTANT1N3/agent-review-hub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/K0NSTANT1N3/agent-review-hub.git",
    "directory": "packages/node"
  },
  "bugs": {
    "url": "https://github.com/K0NSTANT1N3/agent-review-hub/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "quorum-node": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.302",
    "@quorum/protocol": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "pino": "^9.14.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/ws": "^8.18.2"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
